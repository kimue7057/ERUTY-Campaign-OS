# 템플릿만 포함합니다. 실제 .env와 비밀값은 커밋하지 마세요.
DATABASE_URL=postgresql://APP_USER:REPLACE_ME@127.0.0.1:5432/eruty_campaign
TEST_DATABASE_URL=postgresql://TEST_USER:REPLACE_ME@127.0.0.1:5432/eruty_test
APP_BASE_URL=http://127.0.0.1:3000
# 인증 미설정은 모든 업무 API를 차단합니다.
AUTH_MODE=disabled
ALLOW_DEMO_AUTH=false
# 개발 DEMO: AUTH_MODE=demo, ALLOW_DEMO_AUTH=true (production에서 무조건 차단)
# 운영 인증 프록시: AUTH_MODE=proxy + 다음 값을 보안 저장소에서 주입
# AUTH_PROXY_SECRET=32자_이상_프록시와_공유한_비밀값
# AUTH_ISSUER=https://YOUR_INTERNAL_AUTH_PROXY
# AUTH_AUDIENCE=eruty-campaign-os
