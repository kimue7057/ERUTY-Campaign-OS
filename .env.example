# 템플릿만 포함합니다. 실제 .env와 비밀값은 커밋하지 마세요.
DATABASE_URL=postgresql://APP_USER:REPLACE_ME@127.0.0.1:5432/eruty_campaign
# Supabase 운영: DATABASE_URL은 transaction pooler(6543), DIRECT_URL은 session pooler(5432) 또는 직접 연결.
# DIRECT_URL=postgresql://DB_USER.PROJECT_REF:REPLACE_ME@REGION.pooler.supabase.com:5432/postgres?sslmode=verify-full
# DATABASE_CA_CERT=Supabase에서_다운로드한_루트_CA_PEM_전체
# Prisma DIRECT_URL에는 sslmode=verify-full&sslrootcert=인증서_파일_절대경로를 지정합니다.
TEST_DATABASE_URL=postgresql://TEST_USER:REPLACE_ME@127.0.0.1:5432/eruty_test
APP_BASE_URL=http://127.0.0.1:3000
# 인증 미설정은 모든 업무 API를 차단합니다.
AUTH_MODE=disabled
ALLOW_DEMO_AUTH=false
# Supabase 운영 로그인: AUTH_MODE=supabase. 두 값은 서버에서만 사용합니다.
# SUPABASE_URL=https://PROJECT_REF.supabase.co
# SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
# 개발 DEMO: AUTH_MODE=demo, ALLOW_DEMO_AUTH=true (production에서 무조건 차단)
# 운영 인증 프록시: AUTH_MODE=proxy + 다음 값을 보안 저장소에서 주입
# AUTH_PROXY_SECRET=32자_이상_프록시와_공유한_비밀값
# AUTH_ISSUER=https://YOUR_INTERNAL_AUTH_PROXY
# AUTH_AUDIENCE=eruty-campaign-os
